{
  "manifest_version": 3,
  "name": "MarkIt — Smart Bookmark Manager",
  "version": "1.0.0",
  "description": "Port of the MarkIt web application to a browser extension.",
  "action": {
    "default_popup": "index.html",
    "default_title": "MarkIt"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://gjextbqzkoldqbkyztsp.supabase.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
